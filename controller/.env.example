# Copy this file to .env and fill in.
# One variable per line, no inline comments — this file is read both by
# python-dotenv (app startup) and, in production, by systemd's
# EnvironmentFile directive, which does NOT strip trailing "# comment"
# text the way you might expect. Keep comments on their own line.

# --- Proxmox (snapshot stage) ---
# See README.md "Proxmox setup" for how to create these.

# Proxmox host, e.g. 10.0.0.5 or proxmox.lab -- no https://, no port
PROXMOX_HOST=

# The Proxmox node name hosting your VMs (Datacenter > node name)
PROXMOX_NODE=

# API token id, e.g. kite@pve!snap
PROXMOX_TOKEN_ID=

# API token secret -- shown once when you create the token, save it now.
# On Rocky/RHEL 9+, you can instead keep this out of plaintext entirely
# via systemd LoadCredential= -- see the commented-out lines in
# kite-controller.service. Leave this blank if you do that.
PROXMOX_TOKEN_SECRET=

# true once you have a real cert on Proxmox; Proxmox ships self-signed by default
PROXMOX_VERIFY_SSL=false

# --- App behavior ---

# Shared self-enrollment secret: one secret in every host's install
# command, instead of a one-time token per host -- same pattern as
# Wazuh's authd password or Qualys's Activation ID. Left blank, the
# controller generates one on first start, saves it as enroll_secret
# beside the database and prints it once to its log; set it here to
# choose your own. Anyone holding it can enroll a host, so rotate it if it
# ever leaks. Same systemd LoadCredential= option as PROXMOX_TOKEN_SECRET
# above applies here too, if you'd rather not keep it in plaintext.
KITE_ENROLL_SECRET=

# How long an enrollment token is valid for, in minutes
ENROLL_TOKEN_TTL_MIN=60

# Final wait-and-recheck stage duration, in seconds (shortened for lab use).
# Raising this is safe: the wait no longer blocks the agent's report
# request, it's completed by the background pass below.
SOAK_SECONDS=20

# How often that background pass finishes soak stages whose wait has
# elapsed. This, not SOAK_SECONDS, is what bounds how quickly a finished
# run shows as 'done' — keep it well under SOAK_SECONDS.
DEFERRED_STAGE_INTERVAL_SECONDS=5

# Leave unset/empty for same-origin serving (the default — the controller
# serves its own frontend, see app/main.py's index() route, so this isn't
# needed for normal use). Set to a comma-separated allowlist of exact
# origins only if a separate frontend/integration needs cross-origin
# browser access; avoid "*" given the session cookie.
CORS_ORIGINS=

# --- Storage ---

# SQLite file path
KITE_DB=kite.db

# Where the dnf repo (kite-agent RPM + metadata) is served from,
# mounted at /repo. Defaults to ./repo next to this file — only needs
# setting explicitly in unusual layouts (e.g. the Docker image points
# this at its mounted data volume).
KITE_REPO_DIR=

# --- Monitoring (see README.md "Metrics & monitoring") ---

# How often, in seconds, the background pass checks for stuck job stages
# and hosts that just went offline.
MONITOR_INTERVAL_SECONDS=300

# An agent stage running longer than this (minutes) is flagged stuck.
STUCK_STAGE_MINUTES=60

# 'reboot' gets its own, shorter threshold -- a host still not back after
# this many minutes is more likely gone than mid-reboot.
STUCK_REBOOT_MINUTES=15

# "text" (human-readable, default) or "json" (for log aggregators) --
# applies to the app's own operational log, not the audit trail.
KITE_LOG_FORMAT=text

# /docs, /redoc and /openapi.json answer without sign-in, so they are off
# unless this is true.
KITE_API_DOCS=false

# Set to require "Authorization: Bearer <value>" on /metrics. Blank leaves
# it open to anything that can reach the controller.
KITE_METRICS_TOKEN=
KITE_LOG_LEVEL=INFO

# --- Rollback (see README.md "Rollback backends") ---

# Encrypts the secrets you enter in Settings (Proxmox API tokens,
# notification and LDAP passwords) so they're not stored in the database
# in plaintext. Left blank, the controller generates one on first start
# and saves it as secret_key beside the database. Back that file up with
# the database: anything encrypted under it is unreadable without it.
# Also settable via systemd LoadCredential= as "secret_key" (see
# kite-controller.service), same as PROXMOX_TOKEN_SECRET above.
KITE_SECRET_KEY=

# PROXMOX_HOST/NODE/TOKEN_ID/TOKEN_SECRET/VERIFY_SSL above still work
# unchanged as the Proxmox rollback backend's config -- Settings ->
# Rollback in the UI is the newer, equivalent way to set the same
# thing without editing this file or restarting, and takes priority
# per-field if both are set.

# --- Scheduling (see README.md "Feature completeness") ---

# How often, in seconds, the background loop checks recurring Schedules
# against the current UTC day/hour.
SCHEDULER_INTERVAL_SECONDS=300

# --- Integrations (see README.md "Integrations") ---
# No env vars here on purpose -- outbound notification channels
# (webhook/Slack/email) and the ITSM ticket webhook secret are
# configured entirely through Settings -> Notifications in the UI,
# encrypted at rest under KITE_SECRET_KEY above the same way the
# Proxmox token is.

# --- Enterprise polish (see README.md "Enterprise polish") ---
# No env vars here either -- agent self-update's target version and
# every LDAP/SSO setting are configured entirely through Settings in the
# UI (Settings -> Agent updates / SSO -> LDAP), same "DB, not .env"
# pattern as Phase 9's integrations. The one exception is
# KITE_SECRET_KEY above, which the LDAP bind-account password is
# also encrypted under.

# --- Where things live (defaults shown; the Docker image sets its own) ---
# generated secrets; default: beside the database
# KITE_STATE_DIR=
# the Windows installer and Debian/Ubuntu bundle served to hosts; default: dist/
# KITE_DIST_DIR=
# copies of the database kept from before migrations; 0 keeps all
# KITE_DB_BACKUPS_KEEP=5
# the daily database backups; default: backups/ beside the database
# KITE_BACKUP_DIR=
# PEM root CA agents pin; default: read from Caddy (README: "certificate authority")
# KITE_CA_CERT=
# where to ask Caddy for that root
# KITE_CADDY_ADMIN=http://localhost:2019
# how old Coverage/Topology's guest list may get before it's re-read in the background
# KITE_PROXMOX_CACHE_SECONDS=300
# the agent repo's signing key; default: signing/ beside the database
# KITE_SIGNING_DIR=

# --- Vulnerability data (only if turned on in Settings -> Vulnerabilities) ---
# free key from nvd.nist.gov: NVD's first pass about ten times faster
# KITE_NVD_API_KEY=
# a mirror, if you run one
# KITE_OSV_URL=https://osv-vulnerabilities.storage.googleapis.com
# KITE_NVD_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# KITE_MSRC_URL=https://api.msrc.microsoft.com/sug/v2.0/en-US/affectedProduct

# --- Behind another proxy ---
# IPs of the proxies in front of kite allowed to pass on the client's address (X-Forwarded-For); set it when the proxy is on another host
# KITE_TRUSTED_PROXIES=127.0.0.1,::1
